{
  "name": "driftmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "lint:code": "eslint .",
    "collect": "pnpm --filter @driftmark/collector collect",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @driftmark/db generate",
    "db:migrate": "pnpm --filter @driftmark/db migrate",
    "db:push": "pnpm --filter @driftmark/db push",
    "db:studio": "pnpm --filter @driftmark/db studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
