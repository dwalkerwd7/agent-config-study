# ---- Corpus collector (`pnpm collect`) ----
# A fine-grained PAT with public-repository read access only, so the collector
# cannot reach a private repository at all. `pnpm collect` runs under `op run`,
# so this may be a 1Password secret reference (op://<vault>/<item>/<field>)
# instead of the raw token.
GITHUB_TOKEN=""

# HMAC key for hashing redacted values. Generate with: openssl rand -hex 32
# Never share, commit or publish it.
CORPUS_SALT=""

LOG_LEVEL="info"
