# ---- Postgres (matches docker-compose.yml) ----
DATABASE_URL="postgresql://agent-config-study:agent-config-study@localhost:5432/agent-config-study?schema=public"

# ---- Redis / BullMQ ----
REDIS_URL="redis://localhost:6379"

# ---- API (fastify) ----
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# ---- GitHub OAuth (https://github.com/settings/developers) ----
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# API: optional, a PAT / app token for server-side Octokit calls made outside a user session.
# Collector (`pnpm collect`): required. Use a fine-grained PAT with public-repository
# read access only, so the collector cannot reach a private repository at all.
# `pnpm collect` runs under `op run`, so this may be a 1Password secret reference
# (op://<vault>/<item>/<field>) instead of the raw token.
GITHUB_TOKEN=""

# ---- Corpus collector ----
# HMAC key for hashing redacted values. Generate with: openssl rand -hex 32
# Never share, commit or publish it.
CORPUS_SALT=""

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Web -> API ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
